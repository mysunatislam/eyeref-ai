# Optional research API (FastAPI). The web app works fully on-device without it.
NEXT_PUBLIC_API_URL=http://localhost:8000
# MediaPipe assets. Defaults load from the official CDN; run `npm run fetch-models`
# to self-host them under public/mediapipe for offline/privacy-sensitive use.
NEXT_PUBLIC_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@1.0.1/wasm
NEXT_PUBLIC_FACE_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
