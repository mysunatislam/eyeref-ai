# Copy to .env (never commit .env). All values are optional.

# --- research API (backend) ---
EYEREF_DATA_DIR=./data
EYEREF_DATABASE_URL=sqlite:///./data/eyeref.db
EYEREF_CORS_ORIGINS=http://localhost:3000
# Fernet key for encrypting stored eye images at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EYEREF_STORAGE_KEY=
EYEREF_MODEL_PATH=../ml/artifacts/meridional_mlp.onnx

# --- OPTIONAL third-party AI explanation (Gigalogy Maira) ---
# Leave empty to disable. Used only to rephrase an existing report in plain language;
# never a source of SPH/CYL/AXIS. Requires per-request user consent.
MAIRA_API_KEY=
MAIRA_PROJECT_KEY=
MAIRA_BASE_URL=https://api.recommender.gigalogy.com
MAIRA_GPT_PROFILE_ID=
MAIRA_TIMEOUT_S=20

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
