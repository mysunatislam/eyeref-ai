# Copy to .env (never commit .env). All values are optional.

# --- research API (backend) ---
EYEREF_DATA_DIR=./data
EYEREF_DATABASE_URL=sqlite:///./data/eyeref.db
EYEREF_CORS_ORIGINS=http://localhost:3000
# development (default) | production. Production refuses to start without API tokens or
# EYEREF_STORAGE_KEY, and hides /docs.
EYEREF_ENV=development
# Bearer tokens for the research API (comma-separated; at least 24 characters each). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Paste the same token into the web app under Calibration -> App settings.
EYEREF_API_TOKENS=
# Fernet key for encrypting stored eye images at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EYEREF_STORAGE_KEY=
EYEREF_MODEL_PATH=../ml/artifacts/meridional_mlp.onnx

# --- OPTIONAL AI explanation ---
# Only rephrases an existing report in plain language; never a source of SPH/CYL/AXIS.
# ollama (default): local model, nothing leaves the machine. Install Ollama, then: ollama pull gemma3:4b
# maira: hosted third-party service, needs per-request user consent.   off: disabled.
EYEREF_ASSISTANT=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT_S=90

# Only for EYEREF_ASSISTANT=maira (hosted Gigalogy Maira)
MAIRA_API_KEY=
MAIRA_PROJECT_KEY=
MAIRA_BASE_URL=https://api.recommender.gigalogy.com
MAIRA_GPT_PROFILE_ID=
MAIRA_TIMEOUT_S=20
MAIRA_MAX_RETRIES=2
# Only if your MAIRA_API_KEY was given to you Fernet-encrypted (starts with gAAAAA) and you hold the key that decrypts it:
MAIRA_KEY_DECRYPTION_KEY=

# --- web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# The web app's Content-Security-Policy only lets it connect to itself and NEXT_PUBLIC_API_URL.
# Add other backend origins here (space-separated) before building if users will switch backends.
EYEREF_CSP_CONNECT_SRC=
