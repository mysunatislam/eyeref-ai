    1.0
   ],
   "maxItems": 3,
   "minItems": 3,
   "prefixItems": [
    {
     "type": "number"
    },
    {
     "type": "number"
    },
    {
     "type": "number"
    }
   ],
   "title": "Photometric Gain Rgb",
   "type": "array"
  },
  "calibration_version": {
   "default": "uncalibrated",
   "title": "Calibration Version",
   "type": "string"
  },
  "notes": {
   "default": "",
   "title": "Notes",
